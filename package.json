{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "db:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
    "db:down": "docker compose -f compose.yaml -f compose.dev.yaml stop db",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "test:e2e:up": "docker compose -p portfolio-e2e --env-file e2e/e2e.env up -d --build --wait",
    "test:e2e:down": "docker compose -p portfolio-e2e --env-file e2e/e2e.env down -v",
    "test:e2e": "playwright test",
    "test:restore": "bash scripts/backup-restore-test.sh"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.2": false
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "argon2": "0.45.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
