# Plantilla del .env del servidor. Pasos en docs/deploy.md. El .env real nunca se versiona.
# Reemplazá <subdominio> por el tuyo de DuckDNS. Para cambiar de dominio, ver docs/deploy.md.

APP_ENV=production

POSTGRES_USER=portfolio
# Lo genera el comando de docs/deploy.md: en hexadecimal no hace falta escaparlo en la URL.
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

SITE_URL=https://<subdominio>.duckdns.org
SITE_ADDRESS=<subdominio>.duckdns.org
HTTP_PORT=80
HTTPS_PORT=443

# Backups externos: apagados. Para activarlos, ver "Activar los backups externos" en docs/deploy.md.
# COMPOSE_PROFILES=backups
# Contenido de age.pub. La clave privada nunca va al servidor.
# BACKUP_AGE_RECIPIENT=
# BACKUP_CRON=0 6 * * *
# BACKUP_KEEP_LOCAL=14
# BACKUP_KEEP_REMOTE_DAYS=90
# offsite:<nombre-del-bucket>
# BACKUP_RCLONE_REMOTE=
# El archivo con las credenciales de B2, con permisos 600.
# RCLONE_CONF=./rclone.conf
# BACKUP_HEARTBEAT_URL=

# Contraseña de aplicación de Google, sin espacios. Nunca la de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
