# Copiar a .env y completar. El .env nunca se versiona.

# development | production
# En producción, la API rechaza las credenciales de ejemplo y exige SITE_URL con https.
APP_ENV=development

# ── Base de datos ──────────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Desarrollo local fuera de Docker (npm run dev:api). En Docker la arma compose.yaml.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
# Tests de integración. El nombre de la base debe terminar en _test.
TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_test

# ── URLs ───────────────────────────────────────────────────────
# URL pública del sitio (canonical, sitemap, Open Graph).
SITE_URL=http://localhost:8080
# Dirección para Caddy: ":80" en local o el dominio en producción (p. ej. ejemplo.com).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# ── API ────────────────────────────────────────────────────────
PORT=4000
UPLOADS_DIR=./uploads
# Email de contacto (opcional). Sin esto, los mensajes se guardan pero no se envían.
# Con Gmail: smtp.gmail.com, puerto 587 y una contraseña de aplicación, nunca la de la cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
# URL interna de la API para la web en desarrollo (npm run dev:web).
API_INTERNAL_URL=http://localhost:4000
